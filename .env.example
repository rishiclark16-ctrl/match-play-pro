# Copy this file to .env and fill in your values
# These values can be found in your Lovable project's .env file

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Sentry error tracking (optional, but recommended for production)
# Get your DSN from https://sentry.io
VITE_SENTRY_DSN=""

# Sentry release version (auto-generated during build, but can be overridden)
# This links errors to the correct source maps in Sentry
VITE_SENTRY_RELEASE=""

# ============================================================
# SENTRY SOURCE MAP UPLOAD (required for production builds)
# These are BUILD-TIME variables, not runtime (no VITE_ prefix)
# ============================================================

# Sentry auth token for source map uploads
# Create at: https://sentry.io/settings/auth-tokens/
# Required scopes: project:releases, org:read
SENTRY_AUTH_TOKEN=""

# Sentry organization slug (from your Sentry URL)
# Example: if your URL is https://sentry.io/organizations/my-org/, use "my-org"
SENTRY_ORG=""

# Sentry project slug (from your Sentry project settings)
# Example: if your project URL ends with /projects/my-app/, use "my-app"
SENTRY_PROJECT=""

# Optional: Override the release version (defaults to auto-generated)
# Format: match-golf@YYYY-MM-DD-timestamp
SENTRY_RELEASE=""

# Debug mode (set to "true" to enable console logging in production)
VITE_DEBUG=""

# ============================================================
# SUPABASE EDGE FUNCTION SECRETS (set via Supabase CLI)
# Run: supabase secrets set REVENUECAT_WEBHOOK_AUTH="your-secret"
# ============================================================

# RevenueCat webhook authorization token
# Generate a secure random string and set the same value in:
# 1. Supabase Edge Function secrets: supabase secrets set REVENUECAT_WEBHOOK_AUTH="your-secret"
# 2. RevenueCat webhook config: Dashboard > Project > Webhooks > Authorization header
REVENUECAT_WEBHOOK_AUTH=""

# ============================================================
# iOS BUILD SETTINGS (set in Xcode)
# ============================================================

# RevenueCat API key for in-app purchases
# Get your public iOS API key from RevenueCat dashboard
# Set in Xcode: Build Settings > User-Defined > REVENUECAT_API_KEY
# Or directly in Info.plist under RevenueCatAPIKey
REVENUECAT_API_KEY=""
